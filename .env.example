# Server-side only. Copy to .env.local; never use a VITE_ variable for this key.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_EFFORT=none
# Without an API key the app uses local Markdown search.
# Optional alternative: a self-hosted compatible NIM (localhost only).
# NIM_BASE_URL=http://127.0.0.1:8000/v1
# NIM_MODEL=your-local-model-name
