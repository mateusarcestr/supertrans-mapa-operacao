{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:supertrans:operation-model:1.0.0",
  "title": "Bizagi + POP canonical operation model",
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "bizagi",
            "pop"
          ]
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "member": {
          "type": "string",
          "minLength": 1
        },
        "archiveMember": {
          "type": "string",
          "minLength": 1
        },
        "diagramId": {
          "type": "string",
          "minLength": 1
        },
        "workflowId": {
          "type": "string",
          "minLength": 1
        },
        "elementId": {
          "type": [
            "string",
            "null"
          ]
        },
        "table": {
          "type": "integer",
          "minimum": 1
        },
        "row": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "bodyIndex": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "item": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "file",
        "sha256"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "row"
            ]
          },
          "then": {
            "required": [
              "table",
              "member"
            ]
          }
        },
        {
          "if": {
            "required": [
              "diagramId"
            ]
          },
          "then": {
            "required": [
              "archiveMember",
              "member"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "pop"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "diagramId"
              ]
            }
          }
        }
      ]
    },
