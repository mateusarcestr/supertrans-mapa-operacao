      "acceptanceCriteria": ["Acesso apenas ao papel Porto", "Criação em CRIADA_PORTO", "Encaminhamento automático para PENDENTE_COMERCIAL", "Validação inline dos obrigatórios", "Demanda aparece na fila Comercial"],
      "fields": [{"name": "campos obrigatórios da demanda", "type": "form", "required": true, "rules": ["validar antes de salvar"]}],
