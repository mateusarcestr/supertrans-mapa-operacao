    {
      "key": "STPORTAL-5",
      "summary": "Gestão de Demandas",
      "status": "Concluído",
      "description": "Módulo central do fluxo operacional da SuperTrans. Centraliza o registro, análise, aprovação e rastreabilidade de demandas originadas no Porto ou pelo time Comercial, eliminando comunicação informal e garantindo auditoria completa em todas as etapas do ciclo. Perfis envolvidos: Porto, Comercial, Operacional. Estados citados: CRIADA_PORTO → PENDENTE_COMERCIAL → PENDENTE_OPERACIONAL → APROVADA / REJEITADA_COMERCIAL / REJEITADA_OPERACIONAL.",
      "profiles": ["Porto", "Comercial", "Operacional"],
      "statuses": ["CRIADA_PORTO", "CRIADA_CLIENTE", "PENDENTE_COMERCIAL", "PENDENTE_OPERACIONAL", "REJEITADA_COMERCIAL", "REJEITADA_OPERACIONAL", "APROVADA"],
      "transitions": [
        {"from": "CRIADA_PORTO", "to": "PENDENTE_COMERCIAL", "kind": "automatic"},
        {"from": "PENDENTE_COMERCIAL", "to": "PENDENTE_OPERACIONAL", "kind": "commercial approval"},
        {"from": "PENDENTE_COMERCIAL", "to": "REJEITADA_COMERCIAL", "kind": "commercial rejection"},
        {"from": "PENDENTE_OPERACIONAL", "to": "APROVADA", "kind": "operational approval"},
        {"from": "PENDENTE_OPERACIONAL", "to": "REJEITADA_OPERACIONAL", "kind": "operational rejection"}
      ],
      "acceptanceCriteria": ["Centralizar registro, análise, aprovação e rastreabilidade", "Envolver Porto, Comercial e Operacional", "Manter estados de demanda documentados"],
      "businessRules": ["Demandas podem ser originadas no Porto ou pelo Comercial", "A especificação separa aprovação comercial de aprovação operacional"],
      "dependencies": ["STPORTAL-6", "STPORTAL-7", "STPORTAL-8", "STPORTAL-9", "STPORTAL-10", "STPORTAL-11", "STPORTAL-12", "STPORTAL-220", "STPORTAL-221", "STPORTAL-222", "STPORTAL-223", "STPORTAL-224", "STPORTAL-225", "STPORTAL-226", "STPORTAL-227", "STPORTAL-233"],
      "observations": ["Comentário de atividade de 2026-07-01 registra US-001 a US-006 concluídas e US-007 parcialmente atendida por falta de endpoint dedicado; a página posteriormente mostra o Epic como Concluído/resolvido."],
      "source": {"url": "https://supertranstransportes.atlassian.net/browse/STPORTAL-5", "locator": "description, child issue list, status"}
    },
